  status         ReconciliationStatus
  scope          String               @db.VarChar(80)
  currency       String?              @db.Char(3)
  checkedAt      DateTime             @default(now())
  mismatchCount  Int                  @default(0)
  details        Json?
  requestId      String               @db.VarChar(100)

  @@index([status, checkedAt])
}

model NotificationEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  eventType        NotificationEventType
  aggregateType    String                  @db.VarChar(80)
  aggregateId      String                  @db.VarChar(160)
  applicationId    String?                 @db.Uuid
  actorUserId      String?                 @db.Uuid
  recipientUserId  String                  @db.Uuid
  requestId        String                  @db.VarChar(100)
  deduplicationKey String                  @unique @db.VarChar(240)
  payload          Json
  occurredAt       DateTime                @default(now())
  processingStatus NotificationEventStatus @default(PENDING)
  processedAt      DateTime?
  attemptCount     Int                     @default(0)
  lastErrorCode    String?                 @db.VarChar(120)
  application      OfferApplication?       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  recipient        User                    @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  notification     UserNotification?

  @@index([processingStatus, occurredAt])
  @@index([recipientUserId, occurredAt])
}

model UserNotification {
  id              String             @id @default(uuid()) @db.Uuid
  eventId         String             @unique @db.Uuid
  recipientUserId String             @db.Uuid
  applicationId   String?            @db.Uuid
  type            String             @db.VarChar(120)
  entityType      String             @db.VarChar(80)
  entityId        String             @db.VarChar(160)
  titleKey        String             @db.VarChar(160)
  messageData     Json
  actionUrl       String?            @db.VarChar(500)
  actionRequired  Boolean            @default(false)
  createdAt       DateTime           @default(now())
  readAt          DateTime?
  resolvedAt      DateTime?
  supersededAt    DateTime?
  event           NotificationEvent  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  recipient       User               @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  application     OfferApplication?  @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, actionRequired, resolvedAt])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  sessionVersion   Int       @default(0)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?   @db.VarChar(500)
  ipAddress        String?   @db.VarChar(64)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model AdminRecoveryCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  codeHash  String   @unique @db.Char(64)
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(80)
  entityId    String   @db.VarChar(160)
  requestId   String   @db.VarChar(100)
  metadata    Json?
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model BackupRun {
  id           String          @id @default(uuid()) @db.Uuid
  kind         BackupKind
  status       BackupRunStatus @default(STARTED)
  repository   String          @db.VarChar(500)
  snapshotId   String?         @db.VarChar(160)
  manifest     Json?
  errorMessage String?         @db.VarChar(1000)
  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([kind, startedAt])
  @@index([status, startedAt])
}
