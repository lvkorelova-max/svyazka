  promoCode             String?                     @db.VarChar(80)
  productLines          Json?
  schemaVersion         String                      @default("1.0") @db.VarChar(20)
  payload               Json
  payloadHash           String                      @db.Char(64)
  authenticationContext Json
  requestId             String                      @db.VarChar(100)
  processingStatus      Stage8EventProcessingStatus @default(RECEIVED)
  attemptCount          Int                         @default(0)
  nextAttemptAt         DateTime?
  processedAt           DateTime?
  lastErrorCode         String?                     @db.VarChar(120)
  lastErrorMessage      String?                     @db.VarChar(500)
  brand                 BrandProfile                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  trackerInstallation   TrackerInstallation?        @relation(fields: [trackerInstallationId], references: [id], onDelete: Restrict)
  orderImport           OrderImport?                @relation(fields: [orderImportId], references: [id], onDelete: Restrict)
  order                 Order?                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attributionEvidence   AttributionEvidence[]
  tildaPaymentProbe     TildaPaymentProbe?
  timelineEvents        OrderTimelineEvent[]
  createdAt             DateTime                    @default(now())

  @@unique([brandId, sourceNamespace, externalEventId])
  @@index([brandId, canonicalOrderKey, occurredAt])
  @@index([processingStatus, nextAttemptAt])
}

model AttributionEvidence {
  id                             String                         @id @default(uuid()) @db.Uuid
  orderId                        String                         @db.Uuid
  orderEventId                   String                         @db.Uuid
  evidenceType                   Stage8EvidenceType
  source                         Stage8OrderSource
  identifierHash                 String                         @db.Char(64)
  clickSessionId                 String?                        @db.Uuid
  clickId                        String?                        @db.Uuid
  affiliateRelationshipId        String?                        @db.Uuid
  affiliateCommercialAgreementId String?                        @db.Uuid
  creatorId                      String?                        @db.Uuid
  offerId                        String?                        @db.Uuid
  observedAt                     DateTime
  validFrom                      DateTime?
  validUntil                     DateTime?
  validationStatus               Stage8EvidenceValidationStatus
  reasonCode                     String                         @db.VarChar(120)
  metadata                       Json?
  order                          Order                          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderEvent                     Stage8OrderEvent               @relation(fields: [orderEventId], references: [id], onDelete: Restrict)
  clickSession                   ClickSession?                  @relation(fields: [clickSessionId], references: [id], onDelete: Restrict)
  click                          Click?                         @relation(fields: [clickId], references: [id], onDelete: Restrict)
  affiliateRelationship          AffiliateRelationship?         @relation(fields: [affiliateRelationshipId], references: [id], onDelete: Restrict)
  affiliateCommercialAgreement   AffiliateCommercialAgreement?  @relation(fields: [affiliateCommercialAgreementId], references: [id], onDelete: Restrict)
  createdAt                      DateTime                       @default(now())

  @@index([orderId, validationStatus])
  @@index([orderEventId])
  @@index([identifierHash])
}

model AttributionResult {
  id                             String                        @id @default(uuid()) @db.Uuid
  orderId                        String                        @db.Uuid
  decisionVersion                Int
  status                         Stage8AttributionStatus
  creatorId                      String?                       @db.Uuid
  offerId                        String?                       @db.Uuid
  affiliateRelationshipId        String?                       @db.Uuid
  affiliateCommercialAgreementId String?                       @db.Uuid
  ruleSetId                      String?                       @db.Uuid
  ruleSetVersion                 Int?
  confidenceLevel                Stage8ConfidenceLevel
  confidenceScore                Int
  reasonCodes                    String[]                      @default([])
  evidenceIds                    String[]                      @default([])
  attributedAt                   DateTime?
  decidedByType                  String                        @default("SYSTEM") @db.VarChar(40)
  decidedByUserId                String?                       @db.Uuid
  supersedesResultId             String?                       @unique @db.Uuid
  decisionHash                   String                        @unique @db.Char(64)
  requestId                      String                        @db.VarChar(100)
  order                          Order                         @relation("OrderAttributionResults", fields: [orderId], references: [id], onDelete: Restrict)
  currentForOrder                Order?                        @relation("CurrentOrderAttributionResult")
  creator                        CreatorProfile?               @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  offer                          Offer?                        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  affiliateRelationship          AffiliateRelationship?        @relation(fields: [affiliateRelationshipId], references: [id], onDelete: Restrict)
  affiliateCommercialAgreement   AffiliateCommercialAgreement? @relation(fields: [affiliateCommercialAgreementId], references: [id], onDelete: Restrict)
  ruleSet                        AttributionRuleSet?           @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  decidedBy                      User?                         @relation("AttributionDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  previousResult                 AttributionResult?            @relation("AttributionResultSupersession", fields: [supersedesResultId], references: [id], onDelete: Restrict)
  supersededBy                   AttributionResult?            @relation("AttributionResultSupersession")
  exceptions                     AttributionException[]
  resolvedExceptions             AttributionException[]        @relation("ResolvedAttributionResult")
  timelineEvents                 OrderTimelineEvent[]
  createdAt                      DateTime                      @default(now())

  @@unique([orderId, decisionVersion])
  @@index([status, createdAt])
  @@index([affiliateCommercialAgreementId, attributedAt])
}

model AttributionException {
  id                  String                @id @default(uuid()) @db.Uuid
  brandId             String                @db.Uuid
  orderId             String?               @db.Uuid
  attributionResultId String?               @db.Uuid
  type                Stage8ExceptionType
  severity            String                @default("MEDIUM") @db.VarChar(20)
  status              Stage8ExceptionStatus @default(OPEN)
  reasonCodes         String[]              @default([])
  details             Json?
  dueAt               DateTime
  escalatedAt         DateTime?
  assignedToUserId    String?               @db.Uuid
  resolvedByUserId    String?               @db.Uuid
  resolution          String?               @db.VarChar(1000)
  resolvedAt          DateTime?
  resolvedResultId    String?               @db.Uuid
  requestId           String                @db.VarChar(100)
  brand               BrandProfile          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  order               Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attributionResult   AttributionResult?    @relation(fields: [attributionResultId], references: [id], onDelete: Restrict)
  resolvedResult      AttributionResult?    @relation("ResolvedAttributionResult", fields: [resolvedResultId], references: [id], onDelete: Restrict)
  assignedTo          User?                 @relation("AttributionExceptionAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  resolvedBy          User?                 @relation("AttributionExceptionResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  timelineEvents      OrderTimelineEvent[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([brandId, status, dueAt])
  @@index([status, escalatedAt, dueAt])
}

model OrderTimelineEvent {
  id                  String                  @id @default(uuid()) @db.Uuid
  orderId             String                  @db.Uuid
  orderEventId        String?                 @db.Uuid
  attributionResultId String?                 @db.Uuid
  exceptionId         String?                 @db.Uuid
  eventType           Stage8TimelineEventType
  eventKey            String                  @unique @db.VarChar(240)
  occurredAt          DateTime
  summary             Json
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderEvent          Stage8OrderEvent?       @relation(fields: [orderEventId], references: [id], onDelete: Restrict)
  attributionResult   AttributionResult?      @relation(fields: [attributionResultId], references: [id], onDelete: Restrict)
  exception           AttributionException?   @relation(fields: [exceptionId], references: [id], onDelete: Restrict)
  createdAt           DateTime                @default(now())

  @@index([orderId, occurredAt])
}

model Stage8OutboxEvent {
  id               String             @id @default(uuid()) @db.Uuid
  eventKey         String             @unique @db.VarChar(240)
  eventType        String             @db.VarChar(120)
  aggregateType    String             @db.VarChar(80)
  aggregateId      String             @db.VarChar(160)
  payload          Json
  status           Stage8OutboxStatus @default(PENDING)
  attemptCount     Int                @default(0)
  nextAttemptAt    DateTime?
  processedAt      DateTime?
  lastErrorCode    String?            @db.VarChar(120)
  lastErrorMessage String?            @db.VarChar(500)
  requestId        String             @db.VarChar(100)
  createdAt        DateTime           @default(now())

  @@index([status, nextAttemptAt, createdAt])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  sessionVersion   Int       @default(0)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?   @db.VarChar(500)
  ipAddress        String?   @db.VarChar(64)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model AdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.Char(64)
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorType   String   @default("USER") @db.VarChar(40)
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(80)
  entityId    String   @db.VarChar(160)
  requestId   String   @db.VarChar(100)
  metadata    Json?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model BackupRun {
  id           String          @id @default(uuid()) @db.Uuid
  kind         BackupKind
  status       BackupRunStatus @default(STARTED)
  repository   String          @db.VarChar(500)
  snapshotId   String?         @db.VarChar(160)
  manifest     Json?
  errorMessage String?         @db.VarChar(1000)
  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([kind, startedAt])
  @@index([status, startedAt])
}
