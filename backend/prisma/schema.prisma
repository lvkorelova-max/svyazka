generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRAND
  CREATOR
  ADMIN
  MANAGER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PromotionWithoutProduct {
  YES
  NO
  LIMITED
}

enum OfferStatus {
  DRAFT
  MODERATION
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum OfferImageStatus {
  UPLOADING
  READY
  SUPERSEDED
  FAILED
  DELETED
}

enum CreatorKitAccessLevel {
  DIGITAL
  PRODUCT
}

enum CreatorKitAssetStatus {
  UPLOADING
  READY
  DISABLED
  DELETED
  FAILED
}

enum CreatorKitProcessingStatus {
  NOT_STARTED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CreatorKitAssetType {
  PHOTO
  VERTICAL_VIDEO
  HORIZONTAL_VIDEO
  PRODUCT_PNG
  LOGO
  LIFESTYLE
  TEXTURE_VIDEO
  USAGE_VIDEO
  BANNER
  DOCUMENT
}

enum CreatorKitScenarioChannel {
  REELS
  STORIES
  TELEGRAM
  THREADS
  POST
  SHORT_REVIEW
  SELECTION
}

enum CreatorKitFactType {
  DESCRIPTION
  BENEFITS
  INGREDIENTS
  USAGE
  PRICE
  VOLUME
  COUNTRY
  TARGET_AUDIENCE
  FEATURES
  LIMITATIONS
}

enum CreatorKitClaimType {
  ALLOWED
  FORBIDDEN
}

enum CreatorKitRevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum CreatorProductAccessStatus {
  ACTIVE
  REVOKED
}

enum OfferApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum AffiliateRelationshipStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum CommercialCalculationPolicy {
  LEGACY_DIRECT_RATES_V1
  POOL_65_35_V1
}

enum ApplicationTermsStatus {
  CURRENT_ACCEPTED
  REACCEPTANCE_REQUIRED
  CURRENT_REACCEPTED
  BOUND
}

enum CreatorApplicationAction {
  ACCEPT_COMMERCIAL_TERMS
}

enum TermsAcceptanceType {
  INITIAL_SUBMISSION
  UPDATED_TERMS
  LEGACY_REVIEW
}

enum OrderImportStatus {
  UPLOADED
  VALIDATING
  READY
  IMPORTED
  FAILED
}

enum OrderImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  CONFLICT
}

enum OrderImportAction {
  CREATE
  UPDATE
  SKIP
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum AttributionSource {
  AFFILIATE_CODE
  PROMO_CODE
  CLICK_ID
  WEBSITE_TRACKER
  CSV_IMPORT
  UNATTRIBUTED
}

enum Stage8IntegrationStatus {
  PENDING
  ACTIVE
  PAUSED
  REVOKED
}

enum CustomerDiscountType {
  NONE
  PERCENT
  FIXED_AMOUNT
}

enum CreatorPromoCodeStatus {
  PENDING_PROVISIONING
  PROVISIONING_CONFIRMED
  ACTIVE
  EXPIRED
  REPLACED
  REVOKED
}

enum TildaConnectionStatus {
  SETUP_REQUIRED
  WAITING_FOR_WEBHOOK
  CHECKING_PAYMENT_PROVIDER
  ACTIVE
  ERROR
}

enum TildaPaymentProbeStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum Stage8OrderSource {
  CREATOR_LINK
  CREATOR_PROMO_CODE
  WEBSITE_TRACKER
  TILDA
  CSV_IMPORT
  SHOPIFY
  WOOCOMMERCE
  TIKTOK_SHOP
  META_CAPI
  GA4
  MARKETPLACE
  MANUAL_CORRECTION
  LEGACY_BACKFILL
}

enum Stage8OrderEventType {
  ORDER_CREATED
  PAYMENT_SUCCEEDED
  PARTIAL_REFUND_SUCCEEDED
  REFUND_SUCCEEDED
  ORDER_CANCELLED
  CHARGEBACK_OPENED
  CHARGEBACK_REVERSED
  CHARGEBACK_CONFIRMED
}

enum Stage8EventProcessingStatus {
  RECEIVED
  ACCEPTED
  PROCESSING
  PROCESSED
  RETRY_PENDING
  DEAD_LETTER
  REJECTED
  DUPLICATE
  CONFLICT
}

enum Stage8CommerceOrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  CHARGEBACK
}

enum Stage8EvidenceType {
  SIGNED_ATTRIBUTION_ID
  CLICK_ID
  CREATOR_LINK_CODE
  PROMO_CODE
  TRACKER_SESSION
  CSV_IDENTIFIER
}

enum Stage8EvidenceValidationStatus {
  VALID
  INVALID
  EXPIRED
  INELIGIBLE
  UNKNOWN
}

enum Stage8AttributionStatus {
  PENDING
  AUTO_ATTRIBUTED
  UNATTRIBUTED
  REVIEW_REQUIRED
  MANUALLY_ATTRIBUTED
  SUPERSEDED
}

enum Stage8ConfidenceLevel {
  VERIFIED
  HIGH
  MEDIUM
  NONE
  CONFLICT
}

enum Stage8ExceptionType {
  CONFLICTING_ATTRIBUTION
  DUPLICATE_CONFLICT
  UNSUPPORTED_ATTRIBUTION
  INVALID_AGREEMENT
  OUTSIDE_WINDOW
  SUSPICIOUS_FRAUD
  EVENT_CONFLICT
  MANUAL_CORRECTION_REQUIRED
}

enum Stage8ExceptionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum Stage8FinancialHandoffStatus {
  NOT_READY
  READY
  ENQUEUED
  ACKNOWLEDGED
  RETRY_PENDING
  FAILED
}

enum Stage8OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  RETRY_PENDING
  FAILED
}

enum Stage8TimelineEventType {
  ORDER_EVENT_ACCEPTED
  ATTRIBUTION_COMPLETED
  EXCEPTION_OPENED
  EXCEPTION_RESOLVED
  FINANCE_HANDOFF_ACCEPTED
  FINANCE_HANDOFF_FAILED
}

enum CommissionStatus {
  PENDING
  HOLD
  CONFIRMED
  AVAILABLE
  PAYABLE
  PAID
  REVERSED
  DISPUTED
}

enum LedgerEntryType {
  ACCRUAL
  REVERSAL
  PAYOUT
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
  FAILED
}

enum LedgerTransactionType {
  ACCRUAL
  REVERSAL
  ADJUSTMENT
  PAYOUT
  SETTLEMENT
  RECOVERY
}

enum LedgerAccountType {
  BRAND_OBLIGATION
  CREATOR_PAYABLE
  PLATFORM_REVENUE
  CREATOR_RECOVERABLE
  CASH_CLEARING
}

enum LedgerPostingDirection {
  DEBIT
  CREDIT
}

enum BrandStatementStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  DISPUTED
  CORRECTED
}

enum BrandPaymentStatus {
  RECORDED
  ALLOCATED
  CANCELLED
}

enum FinancialDisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ReconciliationStatus {
  PASSED
  FAILED
}

enum NotificationEventType {
  APPLICATION_COMMERCIAL_TERMS_REACCEPTANCE_REQUIRED
}

enum NotificationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum BackupKind {
  POSTGRES
  MINIO
}

enum BackupRunStatus {
  STARTED
  SUCCESS
  FAILED
}

enum BrandVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum ManagerInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id                            String                            @id @default(uuid()) @db.Uuid
  email                         String                            @unique @db.VarChar(320)
  passwordHash                  String
  role                          UserRole
  status                        UserStatus                        @default(ACTIVE)
  failedLoginAttempts           Int                               @default(0)
  lockedUntil                   DateTime?
  sessionVersion                Int                               @default(0)
  mustChangePassword            Boolean                           @default(false)
  passwordChangedAt             DateTime?
  mfaEnabled                    Boolean                           @default(false)
  mfaSecretEncrypted            String?
  mfaEnrolledAt                 DateTime?
  brandProfile                  BrandProfile?
  creatorProfile                CreatorProfile?
  managerProfile                ManagerProfile?
  sessions                      AuthSession[]
  passwordResetTokens           PasswordResetToken[]
  adminRecoveryCodes            AdminRecoveryCode[]
  auditLogs                     AuditLog[]                        @relation("AuditActor")
  reviewedApplications          OfferApplication[]                @relation("ApplicationReviewer")
  payoutsCreated                Payout[]                          @relation("PayoutCreatedBy")
  payoutsApproved               Payout[]                          @relation("PayoutApprovedBy")
  payoutsPaid                   Payout[]                          @relation("PayoutPaidBy")
  payoutsCancelled              Payout[]                          @relation("PayoutCancelledBy")
  brandsVerified                BrandProfile[]                    @relation("BrandVerifier")
  creatorKitRevisionsCreated    CreatorKitRevision[]              @relation("CreatorKitRevisionCreatedBy")
  creatorKitRevisionsPublished  CreatorKitRevision[]              @relation("CreatorKitRevisionPublishedBy")
  productAccessGranted          CreatorProductAccessGrant[]       @relation("ProductAccessGrantedBy")
  productAccessRevoked          CreatorProductAccessGrant[]       @relation("ProductAccessRevokedBy")
  offerVersionsCreated          OfferVersion[]                    @relation("OfferVersionCreatedBy")
  commercialTermsCreated        CommercialTermsVersion[]          @relation("CommercialTermsCreatedBy")
  applicationTermsAccepted      OfferApplicationTermsAcceptance[] @relation("ApplicationTermsAcceptedBy")
  notificationEventsReceived    NotificationEvent[]               @relation("NotificationRecipient")
  userNotifications             UserNotification[]
  brandStatementsIssued         BrandStatement[]                  @relation("BrandStatementIssuedBy")
  brandPaymentsRecorded         BrandPayment[]                    @relation("BrandPaymentRecordedBy")
  disputesOpened                FinancialDispute[]                @relation("FinancialDisputeOpenedBy")
  trackerInstallationsCreated   TrackerInstallation[]             @relation("TrackerInstallationCreatedBy")
  tildaIntegrationsCreated      TildaIntegration[]                @relation("TildaIntegrationCreatedBy")
  attributionRulesCreated       AttributionRuleSet[]              @relation("AttributionRuleCreatedBy")
  attributionDecisionsMade      AttributionResult[]               @relation("AttributionDecisionActor")
  attributionExceptionsAssigned AttributionException[]            @relation("AttributionExceptionAssignee")
  attributionExceptionsResolved AttributionException[]            @relation("AttributionExceptionResolver")
  brandManagerAssignments       BrandManagerAssignment[]          @relation("BrandManager")
  assignmentsCreated            BrandManagerAssignment[]          @relation("AssignmentCreatedBy")
  assignmentsRemoved            BrandManagerAssignment[]          @relation("AssignmentRemovedBy")
  offersCreated                 Offer[]                           @relation("OfferCreatedByManager")
  offersResponsible             Offer[]                           @relation("OfferCurrentManager")
  relationshipsResponsible      AffiliateRelationship[]           @relation("RelationshipCurrentManager")
  attributedOrders              Order[]                           @relation("OrderAttributionManager")
  managerInvitationsCreated     ManagerInvitation[]               @relation("ManagerInvitationInvitedBy")
  managerInvitationsAccepted    ManagerInvitation[]               @relation("ManagerInvitationAcceptedBy")
  createdAt                     DateTime                          @default(now())
  updatedAt                     DateTime                          @updatedAt

  @@index([role, status])
  @@index([lockedUntil])
}

model ManagerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(160)
  jobTitle    String?  @db.VarChar(160)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrandProfile {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @unique @db.Uuid
  brandName             String                   @db.VarChar(160)
  timezone              String                   @default("Europe/Moscow") @db.VarChar(64)
  legalName             String?                  @db.VarChar(240)
  website               String?                  @db.VarChar(500)
  description           String?
  logoUrl               String?                  @db.VarChar(1000)
  verificationStatus    BrandVerificationStatus  @default(UNVERIFIED)
  verifiedAt            DateTime?
  verifiedByUserId      String?                  @db.Uuid
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy            User?                    @relation("BrandVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  offers                Offer[]
  orderImports          OrderImport[]
  orders                Order[]
  statements            BrandStatement[]
  payments              BrandPayment[]
  disputes              FinancialDispute[]
  trackerInstallations  TrackerInstallation[]
  tildaIntegrations     TildaIntegration[]
  creatorLinks          CreatorLink[]
  creatorPromoCodes     CreatorPromoCode[]
  attributionRuleSets   AttributionRuleSet[]
  stage8OrderEvents     Stage8OrderEvent[]
  attributionExceptions AttributionException[]
  managerAssignments    BrandManagerAssignment[]
  managerInvitations    ManagerInvitation[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([verificationStatus, createdAt])
  @@index([verifiedByUserId])
}

model CreatorProfile {
  id                     String                      @id @default(uuid()) @db.Uuid
  userId                 String                      @unique @db.Uuid
  displayName            String                      @db.VarChar(160)
  description            String?
  socialLinks            Json?
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  applications           OfferApplication[]
  affiliateRelationships AffiliateRelationship[]
  clicks                 Click[]
  commissions            Commission[]
  ledgerEntries          LedgerEntry[]
  payouts                Payout[]
  productAccessGrants    CreatorProductAccessGrant[]
  payoutItems            PayoutItem[]
  creatorLinks           CreatorLink[]
  creatorPromoCodes      CreatorPromoCode[]
  clickSessions          ClickSession[]
  attributionResults     AttributionResult[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
}

model Offer {
  id                           String                             @id @default(uuid()) @db.Uuid
  brandId                      String                             @db.Uuid
  imageId                      String?                            @unique @db.Uuid
  currentOfferVersionId        String?                            @unique @db.Uuid
  currentCommercialTermsId     String?                            @unique @db.Uuid
  title                        String                             @db.VarChar(200)
  description                  String
  productUrl                   String?                            @db.VarChar(1000)
  productPriceKopecks          Int
  creatorCommissionBps         Int
  platformCommissionBps        Int
  customerDiscountType         CustomerDiscountType               @default(NONE)
  customerDiscountBps          Int?
  customerDiscountAmountMinor  BigInt?
  createdByManagerId           String?                            @db.Uuid
  currentManagerId             String?                            @db.Uuid
  promotionWithoutProduct      PromotionWithoutProduct
  status                       OfferStatus                        @default(DRAFT)
  category                     String?                            @db.VarChar(120)
  imageUrl                     String?                            @db.VarChar(1000)
  productRequirementSales      Int                                @default(0)
  allowedPromotionFormats      String[]                           @default([])
  brand                        BrandProfile                       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdByManager             User?                              @relation("OfferCreatedByManager", fields: [createdByManagerId], references: [id], onDelete: SetNull)
  currentManager               User?                              @relation("OfferCurrentManager", fields: [currentManagerId], references: [id], onDelete: SetNull)
  image                        OfferImage?                        @relation("ActiveOfferImage", fields: [imageId], references: [id], onDelete: Restrict)
  imageUploads                 OfferImage[]                       @relation("OfferImageUploads")
  creatorKit                   CreatorKit?
  applications                 OfferApplication[]
  affiliateRelationships       AffiliateRelationship[]
  clicks                       Click[]
  orders                       Order[]
  commissions                  Commission[]
  productAccessGrants          CreatorProductAccessGrant[]
  versions                     OfferVersion[]                     @relation("OfferVersions")
  currentVersion               OfferVersion?                      @relation("CurrentOfferVersion", fields: [currentOfferVersionId], references: [id], onDelete: Restrict)
  commercialTermsVersions      CommercialTermsVersion[]           @relation("OfferCommercialTermsVersions")
  currentCommercialTerms       CommercialTermsVersion?            @relation("CurrentCommercialTerms", fields: [currentCommercialTermsId], references: [id], onDelete: Restrict)
  applicationTermsObservations OfferApplicationTermsObservation[]
  commercialAgreements         AffiliateCommercialAgreement[]
  brandStatementLines          BrandStatementLine[]
  creatorLinks                 CreatorLink[]
  creatorPromoCodes            CreatorPromoCode[]
  clickSessions                ClickSession[]
  attributionRuleSets          AttributionRuleSet[]
  attributionResults           AttributionResult[]
  createdAt                    DateTime                           @default(now())
  updatedAt                    DateTime                           @updatedAt

  @@index([brandId, status])
  @@index([status, createdAt])
  @@index([createdByManagerId])
  @@index([currentManagerId])
}

model OfferVersion {
  id                          String                             @id @default(uuid()) @db.Uuid
  offerId                     String                             @db.Uuid
  version                     Int
  title                       String                             @db.VarChar(200)
  description                 String
  productUrl                  String?                            @db.VarChar(1000)
  productPriceMinor           BigInt
  customerDiscountType        CustomerDiscountType               @default(NONE)
  customerDiscountBps         Int?
  customerDiscountAmountMinor BigInt?
  imageId                     String?                            @db.Uuid
  promotionWithoutProduct     PromotionWithoutProduct
  discoveryCategory           String?                            @db.VarChar(120)
  discoveryTags               String[]                           @default([])
  allowedPromotionFormats     String[]                           @default([])
  visibility                  OfferStatus
  creatorKitRevisionId        String?                            @db.Uuid
  contentHash                 String                             @db.Char(64)
  createdByUserId             String                             @db.Uuid
  requestId                   String                             @db.VarChar(100)
  offer                       Offer                              @relation("OfferVersions", fields: [offerId], references: [id], onDelete: Restrict)
  activeFor                   Offer?                             @relation("CurrentOfferVersion")
  createdBy                   User                               @relation("OfferVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  applicationObservations     OfferApplicationTermsObservation[]
  createdAt                   DateTime                           @default(now())

  @@unique([offerId, version])
  @@unique([offerId, contentHash])
  @@index([offerId, createdAt])
}

model CommercialTermsVersion {
  id                            String                             @id @default(uuid()) @db.Uuid
  offerId                       String                             @db.Uuid
  version                       Int
  calculationPolicy             CommercialCalculationPolicy
  totalCommissionPoolBps        Int
  splitPolicyCode               String                             @db.VarChar(80)
  creatorPoolShareBps           Int
  platformPoolShareBps          Int
  creatorEffectiveGmvBps        Int
  platformEffectiveGmvBps       Int
  currency                      String                             @db.Char(3)
  attributionPolicySnapshot     Json
  attributionWindowSnapshot     Json
  commissionEligibilitySnapshot Json
  confirmationPolicySnapshot    Json
  returnPolicySnapshot          Json
  cancellationPolicySnapshot    Json
  payoutPolicySnapshot          Json
  payoutScheduleSnapshot        Json
  settlementModelSnapshot       Json
  minimumPayoutMinor            BigInt
  contractFingerprint           String                             @db.Char(64)
  createdByUserId               String                             @db.Uuid
  requestId                     String                             @db.VarChar(100)
  offer                         Offer                              @relation("OfferCommercialTermsVersions", fields: [offerId], references: [id], onDelete: Restrict)
  activeFor                     Offer?                             @relation("CurrentCommercialTerms")
  createdBy                     User                               @relation("CommercialTermsCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  observations                  OfferApplicationTermsObservation[]
  acceptances                   OfferApplicationTermsAcceptance[]
  applicableApplications        OfferApplication[]                 @relation("ApplicationApplicableTerms")
  acceptedApplications          OfferApplication[]                 @relation("ApplicationLatestAcceptedTerms")
  agreements                    AffiliateCommercialAgreement[]
  createdAt                     DateTime                           @default(now())

  @@unique([offerId, version])
  @@unique([offerId, contractFingerprint])
  @@index([offerId, createdAt])
}

model OfferImage {
  id               String           @id @default(uuid()) @db.Uuid
  offerId          String           @db.Uuid
  status           OfferImageStatus @default(UPLOADING)
  originalFileName String           @db.VarChar(255)
  extension        String           @db.VarChar(16)
  mimeType         String           @db.VarChar(120)
  byteSize         BigInt
  storageObjectKey String           @unique @db.VarChar(1000)
  completedAt      DateTime?
  deletedAt        DateTime?
  offer            Offer            @relation("OfferImageUploads", fields: [offerId], references: [id], onDelete: Restrict)
  activeFor        Offer?           @relation("ActiveOfferImage")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([offerId, status, createdAt])
}

model CreatorKit {
  id                            String                   @id @default(uuid()) @db.Uuid
  offerId                       String                   @unique @db.Uuid
  activeRevisionId              String?                  @unique @db.Uuid
  draftRevisionId               String?                  @unique @db.Uuid
  offer                         Offer                    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  assets                        CreatorKitAsset[]
  legacyScenarios               CreatorKitScenario[]     @relation("LegacyCreatorKitScenarios")
  legacyFacts                   CreatorKitFact[]         @relation("LegacyCreatorKitFacts")
  legacyClaims                  CreatorKitClaim[]        @relation("LegacyCreatorKitClaims")
  legacyRules                   CreatorKitRule[]         @relation("LegacyCreatorKitRules")
  legacyPublicationRequirements PublicationRequirements? @relation("LegacyCreatorKitPublicationRequirements")
  revisions                     CreatorKitRevision[]     @relation("CreatorKitRevisions")
  activeRevision                CreatorKitRevision?      @relation("CreatorKitActiveRevision", fields: [activeRevisionId], references: [id], onDelete: Restrict)
  draftRevision                 CreatorKitRevision?      @relation("CreatorKitDraftRevision", fields: [draftRevisionId], references: [id], onDelete: Restrict)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
}

model CreatorKitAsset {
  id                        String                     @id @default(uuid()) @db.Uuid
  creatorKitId              String                     @db.Uuid
  title                     String                     @db.VarChar(200)
  assetType                 CreatorKitAssetType
  accessLevel               CreatorKitAccessLevel
  status                    CreatorKitAssetStatus      @default(UPLOADING)
  processingStatus          CreatorKitProcessingStatus @default(NOT_STARTED)
  originalFileName          String                     @db.VarChar(255)
  extension                 String                     @db.VarChar(16)
  mimeType                  String                     @db.VarChar(120)
  byteSize                  BigInt
  storageObjectKey          String                     @unique @db.VarChar(1000)
  previewObjectKey          String?                    @db.VarChar(1000)
  editable                  Boolean                    @default(false)
  textAllowed               Boolean                    @default(false)
  paidAdsAllowed            Boolean                    @default(false)
  approvalRequired          Boolean                    @default(false)
  requiresAffiliateApproval Boolean                    @default(false)
  expiresAt                 DateTime?
  disabledAt                DateTime?
  deletedAt                 DateTime?
  creatorKit                CreatorKit                 @relation(fields: [creatorKitId], references: [id], onDelete: Restrict)
  revisionAssets            CreatorKitRevisionAsset[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([creatorKitId, status, accessLevel])
  @@index([expiresAt])
}

model CreatorKitScenario {
  id                        String                    @id @default(uuid()) @db.Uuid
  creatorKitId              String?                   @db.Uuid
  revisionId                String                    @db.Uuid
  channel                   CreatorKitScenarioChannel
  title                     String                    @db.VarChar(200)
  mainIdea                  String                    @map("idea")
  hook                      String?
  structure                 String?
  cta                       String?
  accessLevel               CreatorKitAccessLevel     @default(DIGITAL)
  requiresAffiliateApproval Boolean                   @default(false)
  sortOrder                 Int                       @default(0)
  creatorKit                CreatorKit?               @relation("LegacyCreatorKitScenarios", fields: [creatorKitId], references: [id], onDelete: Restrict)
  revision                  CreatorKitRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([creatorKitId, accessLevel, sortOrder])
  @@index([revisionId, accessLevel, sortOrder])
}

model CreatorKitFact {
  id                        String                @id @default(uuid()) @db.Uuid
  creatorKitId              String?               @db.Uuid
  revisionId                String                @db.Uuid
  type                      CreatorKitFactType
  value                     String
  accessLevel               CreatorKitAccessLevel @default(DIGITAL)
  requiresAffiliateApproval Boolean               @default(false)
  sortOrder                 Int                   @default(0)
  creatorKit                CreatorKit?           @relation("LegacyCreatorKitFacts", fields: [creatorKitId], references: [id], onDelete: Restrict)
  revision                  CreatorKitRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@unique([creatorKitId, type])
  @@unique([revisionId, type])
  @@index([creatorKitId, sortOrder])
  @@index([revisionId, accessLevel, sortOrder])
}

model CreatorKitClaim {
  id                        String                @id @default(uuid()) @db.Uuid
  creatorKitId              String?               @db.Uuid
  revisionId                String                @db.Uuid
  type                      CreatorKitClaimType
  value                     String
  accessLevel               CreatorKitAccessLevel @default(DIGITAL)
  requiresAffiliateApproval Boolean               @default(false)
  sortOrder                 Int                   @default(0)
  creatorKit                CreatorKit?           @relation("LegacyCreatorKitClaims", fields: [creatorKitId], references: [id], onDelete: Restrict)
  revision                  CreatorKitRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([creatorKitId, type, sortOrder])
  @@index([revisionId, type, accessLevel, sortOrder])
}

model CreatorKitRule {
