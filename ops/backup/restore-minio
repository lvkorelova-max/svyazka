#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/backup/common.sh

require_env RESTIC_REPOSITORY RESTIC_PASSWORD TARGET_S3_ENDPOINT TARGET_S3_ACCESS_KEY TARGET_S3_SECRET_KEY TARGET_S3_BUCKET RESTORE_CONFIRMATION
if [ "$RESTORE_CONFIRMATION" != "RESTORE MINIO $TARGET_S3_BUCKET" ]; then
  printf 'Restore confirmation did not match target bucket\n' >&2
  exit 1
fi
if [ "${RESTORE_ENVIRONMENT:-production}" = "production" ] &&
   [ "${ALLOW_PRODUCTION_RESTORE:-false}" != "true" ]; then
  printf 'Production restore requires ALLOW_PRODUCTION_RESTORE=true\n' >&2
  exit 1
fi

restore_dir="/restore/minio"
rm -rf "$restore_dir"
mkdir -p "$restore_dir"
restic unlock --remove-all >/dev/null
restic restore "${MINIO_SNAPSHOT_ID:-latest}" --tag minio --target "$restore_dir"
objects_dir="$(find "$restore_dir" -type d -name objects | head -n 1)"
checksums="$(find "$restore_dir" -name OBJECT_SHA256SUMS -type f | head -n 1)"
test -n "$objects_dir"
test -n "$checksums"
mc alias set target "$TARGET_S3_ENDPOINT" "$TARGET_S3_ACCESS_KEY" "$TARGET_S3_SECRET_KEY" >/dev/null
mc mb --ignore-existing "target/$TARGET_S3_BUCKET" >/dev/null
mc anonymous set none "target/$TARGET_S3_BUCKET" >/dev/null
mc mirror --overwrite --remove "$objects_dir" "target/$TARGET_S3_BUCKET"
(
  cd "$objects_dir"
  sha256sum --check "$checksums"
)
printf 'MinIO restore completed for %s\n' "$TARGET_S3_BUCKET"
