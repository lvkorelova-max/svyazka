#!/usr/bin/env bash
set -Eeuo pipefail

interval="${BACKUP_INTERVAL_SECONDS:-86400}"
if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 3600 ]; then
  printf 'BACKUP_INTERVAL_SECONDS must be an integer of at least 3600\n' >&2
  exit 1
fi

while true; do
  /opt/backup/backup-all
  sleep "$interval"
done
