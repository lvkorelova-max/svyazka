#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/backup/common.sh

require_env DATABASE_URL RESTIC_REPOSITORY RESTIC_PASSWORD S3_ENDPOINT_INTERNAL S3_ACCESS_KEY S3_SECRET_KEY S3_BUCKET
run_id="$(start_backup_run MINIO)"
work_dir="/staging/minio/$(date -u +%Y%m%dT%H%M%SZ)"
objects_dir="$work_dir/objects"
mkdir -p "$objects_dir"

on_error() {
  fail_backup_run "$run_id" "MinIO backup failed"
}
trap on_error ERR

ensure_repository
mc alias set source "$S3_ENDPOINT_INTERNAL" "$S3_ACCESS_KEY" "$S3_SECRET_KEY" >/dev/null
mc mirror --overwrite --remove "source/$S3_BUCKET" "$objects_dir"
(
  cd "$objects_dir"
  find . -type f -print0 | sort -z | xargs -0 -r sha256sum > "$work_dir/OBJECT_SHA256SUMS"
)

object_count="$(find "$objects_dir" -type f | wc -l | tr -d ' ')"
cat > "$work_dir/manifest.json" <<EOF
{"kind":"MINIO","createdAt":"$(date -u +%Y-%m-%dT%H:%M:%SZ)","bucket":"$S3_BUCKET","objectCount":$object_count,"retentionDays":$(retention_days)}
EOF

snapshot_id="$(
  restic backup "$work_dir" --tag minio --json |
    jq -r 'select(.message_type == "summary") | .snapshot_id' |
    tail -n 1
)"
test -n "$snapshot_id"
restic forget --tag minio --keep-daily "$(retention_days)" --prune
complete_backup_run "$run_id" "$snapshot_id" "$(cat "$work_dir/manifest.json")"
printf '%s\n' "$snapshot_id"
